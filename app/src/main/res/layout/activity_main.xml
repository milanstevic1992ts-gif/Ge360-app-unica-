<?xml version="1.0" encoding="utf-8"?>
<!--
  ATTENZIONE: questo layout NON viene gonfiato.

  MainActivity costruisce la propria shell in codice (buildBootstrapShell), per
  scelta: il guscio di avvio resta indipendente da XML e database.

  Il file resta perche' e' l'unico posto che dichiara @+id/mainContainer, l'id
  del contenitore dei fragment usato da MainActivity. Se un giorno lo si
  cancella, spostare prima quell'id in res/values/ids.xml.

  La barra in basso che era disegnata qui era una copia divergente di quella
  vera: e' stata rimossa per non dare l'impressione che fosse lei a decidere
  l'aspetto della navigazione.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ge360_background">

    <FrameLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
