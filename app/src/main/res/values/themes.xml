<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GE360" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- EDIL MILAN STEVIC: arancione cantiere + verde scuro del marchio -->
        <item name="colorPrimary">#B87400</item>
        <item name="colorPrimaryVariant">#8E5900</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#384234</item>
        <item name="colorSecondaryVariant">#283028</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#1F2421</item>
        <item name="colorOnBackground">#1F2421</item>
        <item name="android:colorAccent">#E49A12</item>

        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#F6F5F2</item>
        <item name="android:colorBackground">#F6F5F2</item>
        <item name="android:textColorPrimary">#1F2421</item>
        <item name="android:textColorSecondary">#6B736C</item>
        <item name="android:statusBarColor">#F6F5F2</item>
        <item name="android:navigationBarColor">#F6F5F2</item>

        <!-- Questi stili si propagano ai moduli che usano MaterialButton/CardView. -->
        <item name="materialButtonStyle">@style/Widget.GE360.Button</item>
        <item name="materialCardViewStyle">@style/Widget.GE360.Card</item>
    </style>

    <style name="Widget.GE360.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.GE360.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">#E4E1D9</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">#FFFFFF</item>
    </style>
</resources>
